<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <TargetFramework>net9.0</TargetFramework>
    <Product>QuantConnect.Brokerages.MetaTrader</Product>
    <AssemblyName>QuantConnect.Brokerages.MetaTrader</AssemblyName>
    <RootNamespace>QuantConnect.Brokerages.MetaTrader</RootNamespace>
    <AssemblyTitle>QuantConnect.Brokerages.MetaTrader</AssemblyTitle>
    <OutputType>Library</OutputType>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Description>QuantConnect LEAN MetaTrader Brokerage: Brokerage MetaTrader plugin for Lean</Description>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>full</DebugType>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Lean\Common\Properties\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <ProjectReference Include="..\Brokerages\QuantConnect.Brokerages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MtProxyUI\MT\MT.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MT5Connector">
      <HintPath>Dlls\MT5Connector.dll</HintPath>
    </Reference>
    <Reference Include="MtApi">
      <HintPath>..\..\Lean\mtapi\build\products\Debug\net8.0\MtApi.dll</HintPath>
    </Reference>
    <Reference Include="MtApi5">
      <HintPath>..\..\Lean\mtapi\build\products\Debug\net8.0\MtApi5.dll</HintPath>
    </Reference>
    <Reference Include="MtClient">
      <HintPath>..\..\Lean\mtapi\build\products\Debug\net8.0\MtClient.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>Dlls\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
